# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database Connection (Supabase Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Direct Database Connection (Supabase Session Pooler / Direct - Port 5432)
DIRECT_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Private MCP boundary (server-only; configure separately for staging/production)
# Exact origin without a trailing slash. Local HTTP is allowed only outside production.
THREADCORE_APP_ORIGIN=https://your-storefront.example
THREADCORE_MCP_ISSUER=urn:threadcore:staging:chat-backend
THREADCORE_MCP_AUDIENCE=urn:threadcore:staging:private-mcp
# Active key ID and a JSON map of up to 3 key IDs to random 32-byte base64url keys.
# Generate/set keys through your secret manager; no real key belongs in this file.
THREADCORE_MCP_SIGNING_KID=
THREADCORE_MCP_SIGNING_KEYS=

# Optional trusted database CA PEM if the platform's trust store needs it.
# Keep certificate validation enabled. Set the actual PEM through server configuration.
THREADCORE_DB_CA_PEM=
