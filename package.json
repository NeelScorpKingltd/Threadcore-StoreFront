{
  "name": "threadcore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "mcp:playground": "node --conditions=react-server --import tsx scripts/mcp-playground.ts",
    "build": "next build",
    "build:secure": "npm run security:source && npm run build && npm run security:artifacts",
    "start": "next start",
    "lint": "eslint",
    "test:domain": "node --conditions=react-server --import tsx scripts/test-domain-isolated.ts",
    "test:auth": "node --conditions=react-server --import tsx scripts/test-mcp-auth.ts",
    "test:mcp": "node --conditions=react-server --import tsx scripts/test-mcp-transport.ts",
    "test:runtime": "node --conditions=react-server --import tsx scripts/test-chat-deadline.ts && node --conditions=react-server --import tsx scripts/test-chat-audit.ts && node --conditions=react-server --import tsx scripts/test-chat-capacity.ts",
    "security:source": "node scripts/scan-security.mjs source",
    "security:history": "node scripts/scan-security.mjs history",
    "security:artifacts": "node scripts/scan-security.mjs artifacts",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "test": "npm run test:auth && npm run test:mcp && npm run test:runtime && npm run test:domain"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
