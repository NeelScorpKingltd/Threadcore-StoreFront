    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/otel": "^2.3.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.17",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
