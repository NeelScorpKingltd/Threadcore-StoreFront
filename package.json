{
  "name": "threadcore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:secure": "npm run security:source && npm run build && npm run security:artifacts",
    "start": "next start",
    "lint": "eslint",
    "security:source": "node scripts/scan-security.mjs source",
    "security:history": "node scripts/scan-security.mjs history",
